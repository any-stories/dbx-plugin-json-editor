# ==========================================
# Default
# ==========================================
* text=auto

# ==========================================
# Source code
# ==========================================
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.mts      text eol=lf
*.cts      text eol=lf

# ==========================================
# Web assets
# ==========================================
*.html     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.sass     text eol=lf
*.less     text eol=lf
*.svg      text eol=lf
*.vue      text eol=lf

# ==========================================
# Configuration
# ==========================================
*.json     text eol=lf
*.jsonc    text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.toml     text eol=lf
*.xml      text eol=lf
*.properties text eol=lf
*.ini      text eol=lf
*.conf     text eol=lf

# ==========================================
# Documentation
# ==========================================
*.md       text eol=lf
*.mdx      text eol=lf
*.txt      text eol=lf
*.adoc     text eol=lf
*.rst      text eol=lf

# ==========================================
# Scripts
# ==========================================
*.sh       text eol=lf
*.bash     text eol=lf
*.zsh      text eol=lf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ==========================================
# Git files
# ==========================================
.gitattributes text eol=lf
.gitignore     text eol=lf
*.editorconfig text eol=lf

